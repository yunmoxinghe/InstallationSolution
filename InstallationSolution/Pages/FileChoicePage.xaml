<Page
    x:Class="InstallationSolution.Pages.FileChoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel MaxWidth="500" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Spacing="32">
            
            <!-- 文件信息 -->
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Image x:Name="FileIcon"
                       Width="80" Height="80"
                       Source="ms-appx:///Assets/files.png"
                       HorizontalAlignment="Center"/>
                <TextBlock x:Name="FileNameText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="450"/>
            </StackPanel>

            <!-- 选项按钮 -->
            <StackPanel Spacing="12">
                <!-- 安装选项 -->
                <Button x:Name="InstallButton"
                        HorizontalAlignment="Stretch"
                        Height="80"
                        Click="InstallButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="16" Padding="12,0">
                        <FontIcon Glyph="&#xE896;" FontSize="24"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="安装此应用"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="直接安装到此计算机"
                                       FontSize="12"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 生成安装器选项 -->
                <Button x:Name="GenerateButton"
                        HorizontalAlignment="Stretch"
                        Height="80"
                        Click="GenerateButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="16" Padding="12,0">
                        <FontIcon Glyph="&#xE8F4;" FontSize="24"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="生成独立安装器"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="创建可在其他电脑上运行的安装程序"
                                       FontSize="12"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
