<Page
    x:Class="InstallationSolution.Pages.InstallationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InstallationSolution.Controls">

    <Grid>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 主内容区：左侧信息 + 右侧图标 -->
            <Grid Grid.Row="0" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：三个状态区域叠放，靠 Visibility 切换 -->
                <Grid Grid.Column="0" VerticalAlignment="Stretch">

                    <!-- ① 初始信息区 -->
                    <Grid x:Name="InfoContainer" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="AppNameText"
                            Grid.Row="0"
                            FontSize="{ThemeResource PivotHeaderItemFontSize}"
                            FontWeight="SemiLight"
                            OpticalMarginAlignment="TrimSideBearings"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />

                        <TextBlock
                            x:Name="AppPublisherText"
                            Grid.Row="1"
                            MaxLines="4"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />

                        <InfoBar
                            x:Name="PackageInfoBar"
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title=""
                            Message="" />

                        <Grid Grid.Row="3" Margin="0,24,0,0">
                            <controls:CapabilitiesInfoControl
                                x:Name="AppCapabilities"
                                HeadText="此应用需要以下权限"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <!-- ② 安装中区域 -->
                    <Grid x:Name="InstallingContainer" Visibility="Collapsed" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="StatusText"
                            Grid.Row="0"
                            FontSize="{ThemeResource PivotHeaderItemFontSize}"
                            FontWeight="SemiLight"
                            OpticalMarginAlignment="TrimSideBearings"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />

                        <TextBlock
                            x:Name="DetailText"
                            Grid.Row="1"
                            MaxLines="2"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    </Grid>

                    <!-- ③ 结果区域 -->
                    <Grid x:Name="ResultContainer" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="ResultTitle"
                            Grid.Row="0"
                            FontSize="{ThemeResource PivotHeaderItemFontSize}"
                            FontWeight="SemiLight"
                            OpticalMarginAlignment="TrimSideBearings"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />

                        <TextBlock
                            x:Name="ResultSubtitle"
                            Grid.Row="1"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <InfoBar
                                x:Name="ErrorInfoBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Error"
                                Title="错误详情" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 右侧图标（始终显示） -->
                <Border
                    Grid.Column="1"
                    Width="90" Height="90"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                    <Image
                        x:Name="AppIconImage"
                        Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                        Stretch="Uniform" />
                </Border>
            </Grid>

            <!-- 底部区域 -->
            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 进度条（安装中显示） -->
                <StackPanel
                    x:Name="ProgressContainer"
                    Grid.Row="0"
                    Margin="0,24,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ProgressText"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <ProgressBar
                        x:Name="InstallProgressBar"
                        Height="12"
                        Minimum="0" Maximum="100"
                        Value="0"
                        IsIndeterminate="True"
                        HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- 按钮行 -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="InstallButton"
                            Width="120" Height="32"
                            Margin="12,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="InstallButton_Click">
                            <TextBlock
                                x:Uid="HomePageInstallButton"
                                ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                        </Button>
                        <Button
                            x:Name="LaunchButton"
                            Width="120" Height="32"
                            Margin="12,0,0,0"
                            Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="LaunchButton_Click">
                            <TextBlock
                                x:Uid="ResultPageLaunchButton"
                                ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                        </Button>
                        <Button
                            x:Name="CloseButton"
                            Width="120" Height="32"
                            Margin="12,0,0,0"
                            Visibility="Collapsed"
                            Click="CloseButton_Click">
                            <TextBlock
                                x:Uid="ResultPageCloseButton"
                                ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
