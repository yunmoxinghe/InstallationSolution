<Page x:ConnectionId='1'
    x:Class="InstallerGenerator.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    AllowDrop="True"
                            
                    >

    <ScrollViewer>
        <Grid Padding="20">
            <StackPanel MaxWidth="1000" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>

                <!-- 页面标题 -->
                <TextBlock x:Uid="HomePageTitle"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="1,0,0,16"/>

                <!-- Step 1：选择安装包 -->
                <TextBlock x:Uid="StepPackage"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="1,0,0,6"/>

                <controls:SettingsCard x:Uid="PackageCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7B8;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:ConnectionId='9' x:Name="PackagePathText"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Text="未选择文件"/>
                        <Button x:ConnectionId='10' x:Uid="BrowseButton"
                                                           />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Step 2：输出路径 -->
                <TextBlock x:Uid="StepOutput"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="1,12,0,6"/>

                <controls:SettingsCard x:Uid="OutputCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:ConnectionId='7' x:Name="OutputPathText"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Text="未选择路径"/>
                        <Button x:ConnectionId='8' x:Uid="BrowseOutputButton"
                                                          />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- 生成按钮 -->
                <Button x:ConnectionId='2' x:Uid="GenerateButton"
                        x:Name="GenerateButton"
                        Margin="0,16,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                                              >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:ConnectionId='5' x:Name="GenerateIcon" Glyph="&#xE8F4;" FontSize="14"/>
                        <TextBlock x:ConnectionId='6' x:Name="GenerateText" x:Uid="GenerateButtonText"/>
                    </StackPanel>
                </Button>

                <!-- 进度/状态 -->
                <InfoBar x:ConnectionId='3' x:Name="StatusBar"
                         Margin="0,12,0,0"
                         IsOpen="False"
                         IsClosable="False"/>

                <ProgressBar x:ConnectionId='4' x:Name="BuildProgress"
                             Margin="0,4,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

