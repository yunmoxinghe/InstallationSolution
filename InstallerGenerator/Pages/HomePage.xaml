<Page
    x:Class="InstallerGenerator.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <ScrollViewer>
        <Grid Padding="20">
            <StackPanel MaxWidth="1000" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>

                <!-- 页面标题 -->
                <TextBlock x:Uid="HomePageTitle"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="1,0,0,16"/>

                <!-- Step 1：选择安装包 -->
                <TextBlock x:Uid="StepPackage"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="1,0,0,6"/>

                <controls:SettingsCard x:Uid="PackageCard"
                                       IsClickEnabled="True"
                                       Click="BrowsePackage_Click">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7B8;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph=""/>
                    </controls:SettingsCard.ActionIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PackagePathText"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Text="未选择文件"/>
                        <Button x:Uid="BrowseButton"
                                Click="BrowsePackage_Click"/>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Step 2：输出路径 -->
                <TextBlock x:Uid="StepOutput"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="1,12,0,6"/>

                <controls:SettingsCard x:Uid="OutputCard"
                                       IsClickEnabled="True"
                                       Click="BrowseOutput_Click">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph=""/>
                    </controls:SettingsCard.ActionIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="OutputPathText"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Text="未选择路径"/>
                        <Button x:Uid="BrowseOutputButton"
                                Click="BrowseOutput_Click"/>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- 生成按钮 -->
                <Button x:Uid="GenerateButton"
                        x:Name="GenerateButton"
                        Margin="0,16,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="Generate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="GenerateIcon" Glyph="&#xE8F4;" FontSize="14"/>
                        <TextBlock x:Name="GenerateText" x:Uid="GenerateButtonText"/>
                    </StackPanel>
                </Button>

                <!-- 进度/状态 -->
                <InfoBar x:Name="StatusBar"
                         Margin="0,12,0,0"
                         IsOpen="False"
                         IsClosable="False"/>

                <ProgressBar x:Name="BuildProgress"
                             Margin="0,4,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>

                <!-- 生成成功后的操作按钮 -->
                <StackPanel x:Name="PostBuildActions"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="OpenFolderButton"
                            x:Uid="OpenFolderButton"
                            Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="打开文件夹"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShareFileButton"
                            x:Uid="ShareFileButton"
                            Click="ShareFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72D;" FontSize="14"/>
                            <TextBlock Text="分享文件"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
